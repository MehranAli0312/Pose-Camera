<!--
  Onboarding images are loaded by name via Resources.getIdentifier(...), so the resource
  shrinker cannot see the reference. Keep them.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/pose_guide_onboard*"
    tools:shrinkMode="safe" />
