<?xml version="1.0" encoding="utf-8"?>
<!-- Trend section header: icon + name on the left, "Show all →" on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/cat_header_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/cat_header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/cat_header_show_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cat_header_show_all_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_all"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/cat_header_show_all_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>
</LinearLayout>
