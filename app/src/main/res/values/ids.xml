<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Navigation destination ids are predeclared here so they land in the module's compile-time
      R class. With android.nonTransitiveRClass=true the app's compile R is built from the local
      resource parse, which does not extract inline @+id declarations from navigation graphs — so
      nav_graph.xml references these with @id/ instead of declaring them via @+id/.
    -->
    <item name="splashFragment" type="id" />
    <item name="onboardingFragment" type="id" />
    <item name="mainFragment" type="id" />

    <!--
      Optional native-ad asset views. NativeAdHelper binds these with findViewById (nullable) and
      guards each with ?.let, so they only need to exist in the R class — the individual native ad
      layouts include them only when that asset is shown.
    -->
    <item name="ad_price" type="id" />
    <item name="ad_stars" type="id" />
    <item name="ad_store" type="id" />
    <item name="ad_advertiser" type="id" />
</resources>
